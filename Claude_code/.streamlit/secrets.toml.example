# Copy to .streamlit/secrets.toml and fill in. The real file is git-ignored; never commit it.
# On Streamlit Community Cloud, paste the same two sections into the app's Secrets box.

[db]
# Supabase "Session pooler" connection string, with your database password filled in
url = "postgresql://postgres.<project-ref>:<DATABASE-PASSWORD>@aws-0-eu-west-1.pooler.supabase.com:5432/postgres"

[app]
# The password you will type to open the dashboard
password = "choose-a-long-passphrase"
